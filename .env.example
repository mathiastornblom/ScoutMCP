SCOUT_BASE_URL=https://your-scout-server:22160
SCOUT_USERNAME=admin@example.com
SCOUT_PASSWORD=your-password-here
SCOUT_DOMAIN=
SCOUT_TEST_OU_PATH=/MCP-Test
SCOUT_IGNORE_TLS=false
# Set to true to enable private endpoints not in the public OpenAPI spec.
# Adds 11 extra tools (system info, settings, predefined commands/paths/images,
# license, admins, server instances, DB cleanup, OU filters, device enrollment).
# These endpoints are undocumented and may change between Scout Board versions.
SCOUT_ENABLE_PRIVATE_ENDPOINTS=false