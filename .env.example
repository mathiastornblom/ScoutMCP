SCOUT_BASE_URL=https://your-scout-server:22160
SCOUT_USERNAME=admin@example.com
SCOUT_PASSWORD=your-password-here
SCOUT_DOMAIN=
# Auth method to Scout Board: password (default) or citrix-cloud.
# citrix-cloud uses a Citrix Cloud service principal instead of username/password:
# a CC bearer token is minted via OAuth2 client-credentials, then exchanged at
# /rest/auth/v1/ccauth/login for a Scout Board JWT (1h lifetime, auto-renewed).
SCOUT_AUTH=password
# Required for citrix-cloud (username/password not needed then):
SCOUT_CC_CLIENT_ID=
SCOUT_CC_CLIENT_SECRET=
SCOUT_CC_CUSTOMER_ID=
# CC token endpoint region: us | eu | ap-s | jp | staging
# (staging uses /root/ in the token path and needs no customer id)
SCOUT_CC_REGION=
# Optional full token-endpoint URL override (takes precedence over region/customer):
SCOUT_CC_TOKEN_URL=
SCOUT_TEST_OU_PATH=/MCP-Test
SCOUT_IGNORE_TLS=false
# Set to true to enable private endpoints not in the public OpenAPI spec.
# Adds 11 extra tools (system info, settings, predefined commands/paths/images,
# license, admins, server instances, DB cleanup, OU filters, device enrollment).
# These endpoints are undocumented and may change between Scout Board versions.
SCOUT_ENABLE_PRIVATE_ENDPOINTS=false# ELIAS (Scout 2611+): when private endpoints are enabled, 9 read-only elias_* tools are added
# (containers, packages, images, certificates metadata, upload status, health). Read-only phase:
# no import/delete/upload/solver/image-save. Not available on Scout versions before 2611.
